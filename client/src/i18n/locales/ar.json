    "text0016": "لوحة القيادة",
    "text0017": "مراقبة المدفوعات المستحقة والمدفوعات وتذكيرات العملاء.",
    "text0018": "جهات اتصال الفواتير والحجم وتعرض العملاء.",
    "text0019": "الإنشاء والحالة وPDF والمدفوعات.",
    "text0020": "تاريخ المجموعات والمراجع.",
    "text0021": "تحليل الديون غير المسددة وأعمار المستحقات.",
    "text0022": "تاريخ التذكيرات وأولويات التحصيل.",
    "text0023": "الخدمات والأسعار قابلة لإعادة الاستخدام في الفواتير.",
    "text0024": "الحسابات والأدوار والوصول إلى الفريق.",
    "text0025": "حوكمة الوصول إلى التطبيق والأذونات.",
    "text0026": "معلومات الشركة المستخدمة في فواتير PDF.",
    "text0027": "تقديم الخدمة",
    "text0028": "تم إعداد إعادة التشغيل وحفظها في التاريخ.",
    "text0029": "من المستحيل الاستعداد لإعادة الإطلاق في الوقت الحالي.",
    "text0030": "غير قادر على إنشاء تذكيرات تلقائية.",
    "text0031": "تم تسجيل الدفع وتحديث رصيد الفاتورة.",
    "text0032": "غير قادر على تسجيل الدفع في هذا الوقت.",
    "text0033": "تم إنشاء الخطة المتكررة بنجاح.",
    "text0034": "تم تحديث حالة الخطة المتكررة.",
    "text0035": "تم إنشاء الفاتورة المتكررة بنجاح.",
    "text0036": "غير قادر على إضافة العميل في هذا الوقت.",
    "text0037": "تم تحديث حالة العميل.",
    "text0038": "غير قادر على تحديث حالة العميل.",
    "text0039": "تم حذف العميل بنجاح.",
    "text0040": "لا يمكن الحذف. التحقق من الحقوق أو الفواتير ذات الصلة.",
    "text0041": "تم تحديث إعدادات الشركة.",
    "text0042": "التوقيع مستحيل تحقق من الحقوق وتكوين التوقيع/الختم.",
    "text0043": "من المستحيل إلغاء التوقيع على هذه الفاتورة.",
    "text0044": "تم تحديث كلمة المرور.",
    "text0045": "غير قادر على تغيير كلمة المرور. تحقق من كلمة المرور الحالية.",
    "text0046": "غير قادر على إرسال البريد الإلكتروني التجريبي. تحقق من تكوين SMTP.",
    "text0047": "غير قادر على تسجيل هذا الأداء.",
    "text0048": "غير قادر على تسجيل هذا المستخدم.",
    "text0049": "تم إنشاء الدور بنجاح.",
    "text0050": "تم تحديث أذونات الدور.",
    "text0051": "تم إنشاء الإذن بنجاح.",
    "text0052": "تم تحديث دور المستخدم.",
    "text0053": "تم تعيين العملاء بنجاح.",
    "text0054": "غير قادر على إنشاء الفاتورة في الوقت الراهن.",
    "text0055": "تم تحديث حالة الفاتورة.",
    "text0056": "غير قادر على تغيير حالة هذه الفاتورة.",
    "text0057": "غير قادر على إرسال الفاتورة عن طريق البريد الإلكتروني. تحقق من تكوين SMTP.",
    "text0058": "يتم حفظ الموضوع محليًا. مزامنة الخادم مستحيلة.",
    "text0059": "انتهت صلاحية الجلسة. قم بتسجيل الدخول مرة أخرى.",
    "text0060": "ليس لديك إذن للوصول إلى هذا القسم.",
    "text0061": "مراقبة الفواتير خلال 7 أيام",
    "text0062": "تحقق من أخطاء البريد الإلكتروني أو أعد التشغيل يدويًا",
    "text0063": "إجراءات الاسترداد لمتابعة",
    "text0064": "يرجى إدخال عنوان بريد إلكتروني صالح.",
    "text0065": "الرجاء إدخال كلمة المرور الخاصة بك.",
    "text0066": "الجلسة مغلقة.",
    "text0067": "قم بتسجيل الدخول لتسجيل تذكير.",
    "text0068": "حدد فاتورة للمتابعة.",
    "text0069": "أرسل الفاتورة قبل تسجيل الدفع.",
    "text0070": "يجب أن يتم تضمين مبلغ الدفعة في الرصيد المتبقي.",
    "text0071": "لا يمكن أن يكون تاريخ الدفع فارغًا أو مستقبليًا.",
    "text0072": "قم بتسجيل الدخول لتسجيل الدفع.",
    "text0073": "قم بتسجيل الدخول لتنزيل ملف PDF.",
    "text0074": "تحميل الفاتورة pdf.",
    "text0075": "غير قادر على تنزيل ملف PDF في الوقت الحالي.",
    "text0076": "يمكن للمسؤول فقط تعديل صور الشركة.",
    "text0077": "التنسيق غير صالح. استخدم PNG أو JPG أو JPEG.",
    "text0078": "الصورة كبيرة جدًا. الحد الأقصى للحجم: 2 ميجابايت.",
    "text0079": "أضف صورة أولاً قبل إزالة الخلفية.",
    "text0080": "يمكن للمسؤول فقط حذف صور الشركة.",
    "text0081": "الحذف جاهز. انقر فوق حفظ للتأكيد.",
    "text0082": "تم تعديل الصورة. انقر فوق حفظ للحفظ.",
    "text0083": "يمكن للمسؤول فقط التوقيع على الفاتورة.",
    "text0084": "تم توقيع هذه الفاتورة بالفعل.",
    "text0085": "قم بإعداد التوقيع والختم قبل التوقيع.",
    "text0086": "يمكن للمسؤول فقط إلغاء التوقيع.",
    "text0087": "لم يتم التوقيع على هذه الفاتورة.",
    "text0088": "افتح ملف PDF للطباعة.",
    "text0089": "غير قادر على طباعة ملف PDF في الوقت الحالي.",
    "text0090": "لا يوجد فاتورة للتصدير.",
    "text0091": "غير قادر على تصدير الفواتير في الوقت الراهن.",
    "text0092": "لا يوجد عملاء للتصدير.",
    "text0093": "غير قادر على تصدير العملاء في هذا الوقت.",
    "text0094": "لا يوجد تذكير للتصدير.",
    "text0095": "غير قادر على تصدير التذكيرات في الوقت الراهن.",
    "text0096": "لا دين للتصدير.",
    "text0097": "غير قادر على تصدير التقرير في هذا الوقت.",
    "text0098": "لا توجد فواتير للتصدير لهذه الفترة.",
    "text0099": "غير قادر على تصدير تقرير ضريبة القيمة المضافة.",
    "text0100": "مطلوب اسم العميل والبريد الإلكتروني.",
    "text0101": "الرجاء تحديد بلد العميل.",
    "text0102": "قم بتسجيل الدخول لإضافة عميل.",
    "text0103": "يمكن للمسؤول فقط تعديل الكتالوج.",
    "text0104": "اسم وسعر الخدمة إلزامية.",
    "text0105": "يمكن للمسؤول فقط إدارة المستخدمين.",
    "text0106": "اسم المستخدم والبريد الإلكتروني مطلوبان.",
    "text0107": "يجب أن تحتوي كلمة المرور على 8 أحرف على الأقل.",
    "text0108": "يمكن للمسؤول فقط تعديل إعدادات الشركة.",
    "text0109": "يجب أن تحتوي كلمة المرور الجديدة على 8 أحرف على الأقل.",
    "text0110": "تأكيد كلمة المرور الجديدة غير متطابق.",
    "text0111": "كلمة المرور الجديدة يجب أن تكون مختلفة عن القديمة.",
    "text0112": "البريد الإلكتروني للمستلم غير صالح.",
    "text0113": "مطلوب الموضوع ورسالة البريد الإلكتروني.",
    "text0114": "يمكن للمسؤول فقط حذف العميل.",
    "text0115": "لا يمكنك إلغاء تنشيط حسابك الخاص.",
    "text0116": "تم تحديث حالة المستخدم.",
