# ─────────────────────────────────────────────────────────────────────────────
# Server Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/billing_db?schema=public"

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="your_access_token_secret_min_64_chars_long_replace_this"
JWT_REFRESH_SECRET="your_refresh_token_secret_min_64_chars_long_replace_this"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Cookie ───────────────────────────────────────────────────────────────────
COOKIE_SECRET="your_cookie_secret_replace_this"

# ── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_URL="http://localhost:5173"

# ── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# 1. Enable 2FA on your Gmail account
# 2. Go to Google Account > Security > App Passwords
# 3. Generate an App Password and paste below
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your.email@gmail.com"
SMTP_PASS="your_gmail_app_password"
SMTP_FROM_NAME="Billing System"
SMTP_FROM_EMAIL="your.email@gmail.com"

# ── File Upload ───────────────────────────────────────────────────────────────
UPLOADS_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Background removal AI, local BiRefNet/RMBG-compatible model
# Install once: python -m pip install -r server\requirements-ai.txt
AI_BACKGROUND_REMOVAL_PYTHON="python"
AI_BACKGROUND_REMOVAL_MODEL="ZhengPeng7/BiRefNet"
AI_BACKGROUND_REMOVAL_IMAGE_SIZE=768
AI_BACKGROUND_REMOVAL_TIMEOUT_MS=180000

# ── App Settings ─────────────────────────────────────────────────────────────
DEFAULT_CURRENCY="MAD"
COMPANY_NAME="Your Company Name"
COMPANY_ADDRESS="123 Main Street, Casablanca, Morocco"
COMPANY_PHONE="+212 6XX XXX XXX"
COMPANY_EMAIL="billing@yourcompany.com"
COMPANY_TAX_NUMBER="IF: XXXXXXXX"
