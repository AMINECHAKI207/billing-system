{
  "name": "billing-server",
  "version": "1.0.0",
  "private": true,
  "description": "Billing & Invoice Management System — Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc --project tsconfig.json && tsc-alias --project tsconfig.json",
    "test:authz": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/customerAuthorization.test.ts",
    "test:email": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/invoiceEmailWorkflow.test.ts",
    "test:users": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/userManagement.test.ts",
    "test:password": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/changePassword.test.ts",
    "test:theme": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/themePreference.test.ts",
    "test:reports": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/reportTaxSummary.test.ts",
    "test:invoice-search": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/invoiceSearch.test.ts",
    "test:invoice-excel": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/invoiceExcelExport.test.ts",
    "test:expenses": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/expenseNotes.test.ts",
    "test:credit-notes": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/creditNotesWorkflow.test.ts",
    "test:contracts": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/contractsWorkflow.test.ts",
    "test:contract-timesheets": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/contractTimesheetsWorkflow.test.ts",
    "test:contract-timesheets-demo": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/contractTimesheetsDemoWorkflow.test.ts",
    "test:ai-assistant": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/aiAssistantWorkflow.test.ts",
    "test:audit": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/enterpriseAuditLog.test.ts",
    "test:devis": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/devisWorkflow.test.ts",
    "test:dashboard": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/dashboardStats.test.ts",
    "test:vat": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/dynamicVat.test.ts",
    "test:signature": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/invoiceSignatureStamp.test.ts",
    "test:health": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/healthReadiness.test.ts",
    "test:env": "ts-node --project tsconfig.json --files -r tsconfig-paths/register src/tests/productionEnvGuard.test.ts",
    "demo:timesheets": "ts-node --project tsconfig.json --files -r tsconfig-paths/register scripts/seed-timesheets-demo.ts",
    "demo:ai-assistant": "ts-node --project tsconfig.json --files -r tsconfig-paths/register scripts/seed-ai-assistant-demo.ts",
    "audit:ai-permissions": "ts-node --project tsconfig.json --files -r tsconfig-paths/register scripts/audit-ai-permissions.ts",
    "demo:timesheets:clean": "ts-node --project tsconfig.json --files -r tsconfig-paths/register scripts/clean-timesheets-demo.ts",
    "test": "npm run test:env && npm run test:health && npm run test:authz && npm run test:email && npm run test:users && npm run test:password && npm run test:theme && npm run test:reports && npm run test:invoice-search && npm run test:invoice-excel && npm run test:expenses && npm run test:credit-notes && npm run test:contracts && npm run test:audit && npm run test:devis && npm run test:dashboard && npm run test:vat && npm run test:signature",
    "e2e:db:prepare": "ts-node --project tsconfig.json --files -r tsconfig-paths/register scripts/prepare-e2e-db.ts",
    "e2e:db:seed": "ts-node --project tsconfig.json --files -r tsconfig-paths/register prisma/seed-e2e.ts",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "ts-node --project tsconfig.json prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:status": "prisma migrate status"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@types/archiver": "^8.0.0",
    "archiver": "^5.3.2",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.15.0",
    "prisma": "^5.14.0",
    "sharp": "^0.35.3",
    "tsconfig-paths": "^4.2.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.9",
    "@types/nodemailer": "^6.4.15",
    "@types/pdfkit": "^0.13.4",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.5.3"
  }
}
