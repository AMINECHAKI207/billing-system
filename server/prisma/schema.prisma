model RecurringPlan {
  id            String              @id @default(uuid()) @db.Uuid
  customerId    String              @map("customer_id") @db.Uuid
  createdById   String              @map("created_by") @db.Uuid
  name          String              @db.VarChar(255)
  frequency     RecurringFrequency
  intervalCount Int                 @default(1) @map("interval_count")
  status        RecurringPlanStatus @default(ACTIVE)
  startDate     DateTime            @map("start_date") @db.Date
  endDate       DateTime?           @map("end_date") @db.Date
  nextRunDate   DateTime            @map("next_run_date") @db.Date
  lastRunAt     DateTime?           @map("last_run_at")
  dueDays       Int                 @default(30) @map("due_days")
  autoSend      Boolean             @default(false) @map("auto_send")
  currency      String              @default("MAD") @db.VarChar(10)
  discount      Decimal             @default(0) @db.Decimal(12, 2)
  notes         String?             @db.Text
  terms         String?             @db.Text
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy  User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items      RecurringPlanItem[]
  invoices   Invoice[]
  executions RecurringExecution[]

  @@index([customerId])
  @@index([createdById])
  @@index([status, nextRunDate])
  @@map("recurring_plans")
}

model RecurringPlanItem {
  id          String  @id @default(uuid()) @db.Uuid
  planId      String  @map("plan_id") @db.Uuid
  description String  @db.Text
  unit        String? @db.VarChar(50)
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  plan RecurringPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("recurring_plan_items")
}

model RecurringExecution {
  id           String                   @id @default(uuid()) @db.Uuid
  planId       String                   @map("plan_id") @db.Uuid
  invoiceId    String?                  @map("invoice_id") @db.Uuid
  scheduledFor DateTime                 @map("scheduled_for") @db.Date
  status       RecurringExecutionStatus
  errorMessage String?                  @map("error_message") @db.Text
  createdAt    DateTime                 @default(now()) @map("created_at")

  plan    RecurringPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  invoice Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([planId, scheduledFor])
  @@index([status])
  @@index([invoiceId])
  @@map("recurring_executions")
}

model Reminder {
  id             String         @id @default(uuid()) @db.Uuid
  invoiceId      String         @map("invoice_id") @db.Uuid
  sentById       String?        @map("sent_by") @db.Uuid // null if sent by system cron
  type           ReminderType
  recipientEmail String         @map("recipient_email") @db.VarChar(255)
  subject        String         @db.VarChar(255)
  body           String         @db.Text
  status         ReminderStatus @default(PENDING)
  sentAt         DateTime?      @map("sent_at")
  errorMessage   String?        @map("error_message") @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sentBy  User?   @relation(fields: [sentById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("reminders")
}
