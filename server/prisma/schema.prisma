  isSigned            Boolean                 @default(false) @map("is_signed")
  contentHash         String                  @map("content_hash") @db.VarChar(128)
  companySignatureUrl String?                 @map("company_signature_url") @db.VarChar(500)
  companyStampUrl     String?                 @map("company_stamp_url") @db.VarChar(500)
  companySignedById   String?                 @map("company_signed_by") @db.Uuid
  companySignedAt     DateTime?               @map("company_signed_at")
  clientSignerName    String?                 @map("client_signer_name") @db.VarChar(255)
  clientSignerEmail   String?                 @map("client_signer_email") @db.VarChar(255)
  clientSignedAt      DateTime?               @map("client_signed_at")
  signedPdfHash       String?                 @map("signed_pdf_hash") @db.VarChar(128)
  signedPdfStorageKey String?                 @map("signed_pdf_storage_key") @db.VarChar(1000)
  revokedAt           DateTime?               @map("revoked_at")
  revokedById         String?                 @map("revoked_by") @db.Uuid
  revocationReason    String?                 @map("revocation_reason") @db.Text
  revocationNote      String?                 @map("revocation_note") @db.Text
  previousPdfHash     String?                 @map("previous_pdf_hash") @db.VarChar(128)
  createdById         String                  @map("created_by") @db.Uuid
  createdAt           DateTime                @default(now()) @map("created_at")

  contract        Contract  @relation("ContractVersions", fields: [contractId], references: [id], onDelete: Cascade)
  createdBy       User      @relation("ContractVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  companySignedBy User?     @relation("ContractVersionCompanySignedBy", fields: [companySignedById], references: [id], onDelete: SetNull)
  revokedBy       User?     @relation("ContractVersionRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  currentFor      Contract? @relation("ContractCurrentVersion")
  signedFor       Contract? @relation("ContractSignedVersion")
  invoices        Invoice[] @relation("ContractVersionInvoices")

  @@unique([contractId, versionNumber])
  @@index([contractId])
  @@index([createdById])
  @@index([signatureStatus])
  @@index([companySignedById])
  @@index([revokedById])
  @@map("contract_versions")
}

model ContractTimeEntry {
  id               String                  @id @default(uuid()) @db.Uuid
  contractId       String                  @map("contract_id") @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  createdById      String                  @map("created_by") @db.Uuid
  approvedById     String?                 @map("approved_by") @db.Uuid
  submittedById    String?                 @map("submitted_by") @db.Uuid
  rejectedById     String?                 @map("rejected_by") @db.Uuid
  invoiceId        String?                 @map("invoice_id") @db.Uuid
  workDate         DateTime                @map("work_date") @db.Date
  startTime        DateTime?               @map("start_time")
  endTime          DateTime?               @map("end_time")
  breakMinutes     Int                     @default(0) @map("break_minutes")
  durationMinutes  Int                     @default(0) @map("duration_minutes")
  billableMinutes  Int                     @default(0) @map("billable_minutes")
  quantity         Decimal                 @db.Decimal(12, 2)
  activityType     String?                 @map("activity_type") @db.VarChar(80)
  description      String                  @db.Text
  internalNote     String?                 @map("internal_note") @db.Text
  billable         Boolean                 @default(true)
  status           ContractTimeEntryStatus @default(DRAFT)
  appliedRate      Decimal?                @map("applied_rate") @db.Decimal(12, 2)
  currency         String?                 @db.VarChar(3)
  calculatedAmount Decimal?                @map("calculated_amount") @db.Decimal(12, 2)
  pricingSnapshot  Json?                   @map("pricing_snapshot")
  rejectionReason  String?                 @map("rejection_reason") @db.Text
  submittedAt      DateTime?               @map("submitted_at")
  approvedAt       DateTime?               @map("approved_at")
  rejectedAt       DateTime?               @map("rejected_at")
  invoicedAt       DateTime?               @map("invoiced_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user        User     @relation("ContractTimeEntryUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy   User     @relation("ContractTimeEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy  User?    @relation("ContractTimeEntryApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  submittedBy User?    @relation("ContractTimeEntrySubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  rejectedBy  User?    @relation("ContractTimeEntryRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  invoice     Invoice? @relation("ContractTimeEntryInvoice", fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@index([userId])
  @@index([userId, workDate])
  @@index([status])
  @@index([invoiceId])
  @@index([contractId, status, invoiceId])
  @@map("contract_time_entries")
}

model ContractMilestone {
