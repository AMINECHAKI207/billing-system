// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  EMPLOYEE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum DevisStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  CREDIT_CARD
  MOBILE_PAYMENT
  OTHER
}

enum ReminderType {
  BEFORE_DUE
  ON_DUE
  AFTER_DUE
  MANUAL
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
}

enum PermissionScope {
  ALL
  OWN
  SELECTED
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RecurringPlanStatus {
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum RecurringExecutionStatus {
  PROCESSING
  SUCCESS
  FAILED
  SKIPPED
}

enum ExpenseSource {
  MANUAL
  AI
}

enum ExpenseAIStatus {
  VALIDATED
  REQUIRES_MANUAL_REVIEW
  FAILED
}

enum ExpenseNoteStatus {
  DRAFT
  PROCESSING
  NEEDS_REVIEW
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  PAID
}

enum CreditNoteStatus {
  DRAFT
  VALIDATED
  CANCELLED
  REFUNDED
}

enum CreditNoteType {
  PARTIAL
  FULL
}

enum ContractStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
}

enum ContractRenewalType {
  NONE
  MANUAL
  AUTOMATIC
}

enum ContractPricingType {
  FIXED
  HOURLY
  DAILY
  MONTHLY
  MONTHLY_SUBSCRIPTION
  ANNUAL_SUBSCRIPTION
  MILESTONE
  CUSTOM
}

enum ContractBillingFrequency {
  ONE_TIME
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM
}

enum ContractProrationPolicy {
  NONE
  ACTUAL_DAYS
  FIXED_30_DAYS
}

enum ContractTimeEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  INVOICED
  LOCKED
}

enum ContractMilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  APPROVED
  INVOICED
  CANCELLED
}

enum ContractBillingScheduleStatus {
  PENDING
  APPROVED
  INVOICED
  CANCELLED
}

enum ContractBillingJobStatus {
  SUCCESS
  FAILED
}

enum ContractSignatureLinkStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum ContractSignatureStatus {
  NOT_STARTED
  COMPANY_PENDING
  COMPANY_SIGNED
  CLIENT_PENDING
  CLIENT_SIGNED
  COMPLETED
  REVOKED
}

enum CreditNoteRefundStatus {
  NOT_REFUNDED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum AiConversationStatus {
  ACTIVE
  ARCHIVED
}

enum AiMessageRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

enum AiActionStatus {
  PENDING
  CONFIRMED
  EXECUTED
  CANCELLED
  EXPIRED
  FAILED
}

enum AiToolRiskLevel {
  READ_ONLY
  CONFIRMATION_REQUIRED
  REAUTH_REQUIRED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @db.VarChar(255)
  email             String             @unique @db.VarChar(255)
  passwordHash      String             @map("password_hash") @db.VarChar(255)
  role              Role               @default(EMPLOYEE)
  rbacRoleId        String?            @map("rbac_role_id") @db.Uuid
  themePreference   String             @default("light") @map("theme_preference") @db.VarChar(20)
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  telegramAccount   TelegramAccount?
  telegramLinkCodes TelegramLinkCode[]

  // Relations
  customers                     Customer[]
  invoices                      Invoice[]              @relation("InvoiceCreatedBy")
  devis                         Devis[]                @relation("DevisCreatedBy")
  signedInvoices                Invoice[]              @relation("InvoiceSignedBy")
  signedDevis                   Devis[]                @relation("DevisSignedBy")
  contractTimeEntries           ContractTimeEntry[]    @relation("ContractTimeEntryUser")
  contractTimeEntriesCreated    ContractTimeEntry[]    @relation("ContractTimeEntryCreatedBy")
  contractTimeEntriesApproved   ContractTimeEntry[]    @relation("ContractTimeEntryApprovedBy")
  contractTimeEntriesSubmitted  ContractTimeEntry[]    @relation("ContractTimeEntrySubmittedBy")
  contractTimeEntriesRejected   ContractTimeEntry[]    @relation("ContractTimeEntryRejectedBy")
  vatOverrides                  Invoice[]              @relation("InvoiceVatOverriddenBy")
  devisVatOverrides             Devis[]                @relation("DevisVatOverriddenBy")
  payments                      Payment[]
  reminders                     Reminder[]
  invoiceEmailLogs              InvoiceEmailLog[]
  assignedClients               UserClientAssignment[]
  recurringPlans                RecurringPlan[]
  expenseNotes                  ExpenseNote[]          @relation("ExpenseNoteCreatedBy")
  approvedExpenseNotes          ExpenseNote[]          @relation("ExpenseNoteApprovedBy")
  rejectedExpenseNotes          ExpenseNote[]          @relation("ExpenseNoteRejectedBy")
  changesRequestedExpenseNotes  ExpenseNote[]          @relation("ExpenseNoteChangesRequestedBy")
  paidExpenseNotes              ExpenseNote[]          @relation("ExpenseNotePaidBy")
  expenseAttachments            ExpenseAttachment[]    @relation("ExpenseAttachmentUploadedBy")
  expenseAIAnalyses             ExpenseAIAnalysis[]    @relation("ExpenseAIAnalysisRequestedBy")
  expenseAuditLogs              ExpenseAuditLog[]      @relation("ExpenseAuditActor")
  expenseEmailLogs              ExpenseEmailLog[]
  creditNotesCreated            CreditNote[]           @relation("CreditNoteCreatedBy")
  creditNotesValidated          CreditNote[]           @relation("CreditNoteValidatedBy")
  creditNotesCancelled          CreditNote[]           @relation("CreditNoteCancelledBy")
  creditNotesRefunded           CreditNote[]           @relation("CreditNoteRefundedBy")
  creditNoteAuditLogs           CreditNoteAuditLog[]   @relation("CreditNoteAuditActor")
  creditNoteEmailLogs           CreditNoteEmailLog[]
  creditNoteReasonsCreated      CreditNoteReason[]
  contractsCreated              Contract[]             @relation("ContractCreatedBy")
  contractsSent                 Contract[]             @relation("ContractSentBy")
  contractsCompanySigned        Contract[]             @relation("ContractCompanySignedBy")
  contractVersionsCreated       ContractVersion[]      @relation("ContractVersionCreatedBy")
  contractVersionsCompanySigned ContractVersion[]      @relation("ContractVersionCompanySignedBy")
  contractVersionsRevoked       ContractVersion[]      @relation("ContractVersionRevokedBy")
  contractTemplatesCreated      ContractTemplate[]     @relation("ContractTemplateCreatedBy")
  contractAuditLogs             ContractAuditLog[]     @relation("ContractAuditActor")
  contractEmailLogs             ContractEmailLog[]
  contractMilestonesApproved    ContractMilestone[]    @relation("ContractMilestoneApprovedBy")
  contractBillingJobs           ContractBillingJob[]
  auditLogs                     AuditLog[]
  aiConversations               AiConversation[]
  aiPendingActions              AiPendingAction[]
  rbacRole                      RbacRole?              @relation(fields: [rbacRoleId], references: [id], onDelete: SetNull)

  @@index([rbacRoleId])
  @@map("users")
}

model TelegramAccount {
  id             String   @id @default(uuid()) @db.Uuid
  telegramUserId String   @unique @map("telegram_user_id") @db.VarChar(50)
  telegramChatId String   @map("telegram_chat_id") @db.VarChar(50)
  userId         String   @unique @map("user_id") @db.Uuid
  linkedAt       DateTime @default(now()) @map("linked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([telegramChatId])
  @@map("telegram_accounts")
}

model TelegramLinkCode {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(32)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("telegram_link_codes")
}

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String?  @map("user_id") @db.Uuid
  module          String   @db.VarChar(80)
  entity          String   @db.VarChar(120)
  entityId        String?  @map("entity_id") @db.VarChar(120)
  action          String   @db.VarChar(80)
  oldValues       Json?    @map("old_values")
  newValues       Json?    @map("new_values")
  metadata        Json?
  ipAddress       String?  @map("ip_address") @db.VarChar(80)
  userAgent       String?  @map("user_agent") @db.VarChar(500)
  browser         String?  @db.VarChar(120)
  operatingSystem String?  @map("operating_system") @db.VarChar(120)
  device          String?  @db.VarChar(120)
  requestId       String?  @map("request_id") @db.VarChar(120)
  sessionId       String?  @map("session_id") @db.VarChar(120)
  httpMethod      String?  @map("http_method") @db.VarChar(12)
  route           String?  @db.VarChar(500)
  statusCode      Int?     @map("status_code")
  success         Boolean  @default(true)
  executionTime   Int?     @map("execution_time")
  createdAt       DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module])
  @@index([entity])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@index([module, entity, entityId])
  @@map("audit_logs")
}

model AiConversation {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  title     String?              @db.VarChar(255)
  status    AiConversationStatus @default(ACTIVE)
  language  String               @default("fr") @db.VarChar(10)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       AiMessage[]
  pendingActions AiPendingAction[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("ai_conversations")
}

model AiMessage {
  id               String        @id @default(uuid()) @db.Uuid
  conversationId   String        @map("conversation_id") @db.Uuid
  role             AiMessageRole
  content          String        @db.Text
  sanitizedContent String?       @map("sanitized_content") @db.Text
  toolName         String?       @map("tool_name") @db.VarChar(120)
  toolCallId       String?       @map("tool_call_id") @db.VarChar(120)
  metadata         Json?
  createdAt        DateTime      @default(now()) @map("created_at")

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([toolName])
  @@map("ai_messages")
}

model AiPendingAction {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  conversationId     String          @map("conversation_id") @db.Uuid
  toolName           String          @map("tool_name") @db.VarChar(120)
  inputPayload       Json            @map("input_payload")
  previewPayload     Json            @map("preview_payload")
  riskLevel          AiToolRiskLevel @map("risk_level")
  requiredPermission String          @map("required_permission") @db.VarChar(120)
  status             AiActionStatus  @default(PENDING)
  idempotencyKey     String          @unique @map("idempotency_key") @db.VarChar(160)
  expiresAt          DateTime        @map("expires_at")
  confirmedAt        DateTime?       @map("confirmed_at")
  cancelledAt        DateTime?       @map("cancelled_at")
  executedAt         DateTime?       @map("executed_at")
  resultPayload      Json?           @map("result_payload")
  errorPayload       Json?           @map("error_payload")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@index([conversationId])
  @@index([toolName])
  @@map("ai_pending_actions")
}

model RbacRole {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  resource    String   @db.VarChar(80)
  action      String   @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String          @map("role_id") @db.Uuid
  permissionId String          @map("permission_id") @db.Uuid
  scope        PermissionScope @default(ALL)
  assignedAt   DateTime        @default(now()) @map("assigned_at")

  role       RbacRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserClientAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Customer @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
  @@map("user_client_assignments")
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  createdById String   @map("created_by") @db.Uuid
  name        String   @db.VarChar(255)
  email       String   @db.VarChar(255)
  phone       String?  @db.VarChar(50)
  company     String?  @db.VarChar(255)
  address     String?  @db.Text
  city        String?  @db.VarChar(100)
  country     String   @default("Morocco") @db.VarChar(100)
  countryCode String   @default("MA") @map("country_code") @db.VarChar(2)
  postalCode  String?  @map("postal_code") @db.VarChar(50)
  taxNumber   String?  @map("tax_number") @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  createdBy      User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  invoices       Invoice[]
  devis          Devis[]
  creditNotes    CreditNote[]
  contracts      Contract[]
  assignedUsers  UserClientAssignment[]
  recurringPlans RecurringPlan[]

  @@index([email])
  @@index([name])
  @@map("customers")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  customerId    String        @map("customer_id") @db.Uuid
  createdById   String        @map("created_by") @db.Uuid
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(50)
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @map("issue_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date

  // Monetary values stored as Decimal to prevent floating point inaccuracies
  subtotal            Decimal   @db.Decimal(12, 2)
  taxRate             Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount           Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  customerCountry     String    @default("Morocco") @map("customer_country") @db.VarChar(100)
  customerCountryCode String    @default("MA") @map("customer_country_code") @db.VarChar(2)
  vatOverridden       Boolean   @default(false) @map("vat_overridden")
  vatOverrideReason   String?   @map("vat_override_reason") @db.VarChar(500)
  vatOverriddenAt     DateTime? @map("vat_overridden_at")
  vatOverriddenById   String?   @map("vat_overridden_by") @db.Uuid
  discount            Decimal   @default(0) @db.Decimal(12, 2)
  total               Decimal   @db.Decimal(12, 2)

  // Denormalized totals for quick dashboard queries
  amountPaid Decimal @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue Decimal @map("balance_due") @db.Decimal(12, 2)

  notes    String? @db.Text
  terms    String? @db.Text
  currency String  @default("MAD") @db.VarChar(10)

  sentAt                        DateTime? @map("sent_at")
  paidAt                        DateTime? @map("paid_at")
  isSigned                      Boolean   @default(false) @map("is_signed")
  signedAt                      DateTime? @map("signed_at")
  signedById                    String?   @map("signed_by") @db.Uuid
  signatureUrl                  String?   @map("signature_url") @db.VarChar(500)
  stampUrl                      String?   @map("stamp_url") @db.VarChar(500)
  sourceDevisId                 String?   @unique @map("source_devis_id") @db.Uuid
  contractId                    String?   @map("contract_id") @db.Uuid
  contractVersionId             String?   @map("contract_version_id") @db.Uuid
  billingPeriodStart            DateTime? @map("billing_period_start") @db.Date
  billingPeriodEnd              DateTime? @map("billing_period_end") @db.Date
  contractBillingScheduleItemId String?   @map("contract_billing_schedule_item_id") @db.Uuid
  contractMilestoneId           String?   @map("contract_milestone_id") @db.Uuid
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  // Relations
  customer                          Customer                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy                         User                         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  signedBy                          User?                        @relation("InvoiceSignedBy", fields: [signedById], references: [id], onDelete: SetNull)
  vatOverriddenBy                   User?                        @relation("InvoiceVatOverriddenBy", fields: [vatOverriddenById], references: [id], onDelete: SetNull)
  items                             InvoiceItem[]
  payments                          Payment[]
  reminders                         Reminder[]
  emailLogs                         InvoiceEmailLog[]
  creditNotes                       CreditNote[]
  recurringExecutions               RecurringExecution[]
  recurringPlanId                   String?                      @map("recurring_plan_id") @db.Uuid
  recurringPlan                     RecurringPlan?               @relation(fields: [recurringPlanId], references: [id], onDelete: SetNull)
  sourceDevis                       Devis?                       @relation("DevisToInvoice", fields: [sourceDevisId], references: [id], onDelete: SetNull)
  contract                          Contract?                    @relation("ContractInvoices", fields: [contractId], references: [id], onDelete: SetNull)
  contractVersion                   ContractVersion?             @relation("ContractVersionInvoices", fields: [contractVersionId], references: [id], onDelete: SetNull)
  contractBillingScheduleItem       ContractBillingScheduleItem? @relation("InvoiceContractBillingScheduleItem", fields: [contractBillingScheduleItemId], references: [id], onDelete: SetNull)
  contractMilestone                 ContractMilestone?           @relation("InvoiceContractMilestone", fields: [contractMilestoneId], references: [id], onDelete: SetNull)
  contractTimeEntries               ContractTimeEntry[]          @relation("ContractTimeEntryInvoice")
  contractBillingJobs               ContractBillingJob[]         @relation("ContractBillingJobInvoice")
  contractMilestonePrimaryFor       ContractMilestone?           @relation("ContractMilestonePrimaryInvoice")
  contractBillingSchedulePrimaryFor ContractBillingScheduleItem? @relation("ContractBillingSchedulePrimaryInvoice")

  @@unique([contractId, billingPeriodStart, billingPeriodEnd])
  @@unique([contractBillingScheduleItemId])
  @@unique([contractMilestoneId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@index([signedById])
  @@index([vatOverriddenById])
  @@index([recurringPlanId])
  @@index([sourceDevisId])
  @@index([contractId])
  @@index([contractVersionId])
  @@index([billingPeriodStart, billingPeriodEnd])
  @@map("invoices")
}

model Devis {
  id                  String      @id @default(uuid()) @db.Uuid
  devisNumber         String      @unique @map("devis_number") @db.VarChar(50)
  companyId           Int         @default(1) @map("company_id")
  customerId          String      @map("customer_id") @db.Uuid
  createdById         String      @map("created_by") @db.Uuid
  status              DevisStatus @default(DRAFT)
  issueDate           DateTime    @map("issue_date") @db.Date
  validUntil          DateTime    @map("valid_until") @db.Date
  subtotal            Decimal     @db.Decimal(12, 2)
  taxRate             Decimal     @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount           Decimal     @default(0) @map("tax_amount") @db.Decimal(12, 2)
  customerCountry     String      @default("Morocco") @map("customer_country") @db.VarChar(100)
  customerCountryCode String      @default("MA") @map("customer_country_code") @db.VarChar(2)
  vatOverridden       Boolean     @default(false) @map("vat_overridden")
  vatOverrideReason   String?     @map("vat_override_reason") @db.VarChar(500)
  vatOverriddenAt     DateTime?   @map("vat_overridden_at")
  vatOverriddenById   String?     @map("vat_overridden_by") @db.Uuid
  discount            Decimal     @default(0) @db.Decimal(12, 2)
  total               Decimal     @db.Decimal(12, 2)
  notes               String?     @db.Text
  terms               String?     @db.Text
  currency            String      @default("MAD") @db.VarChar(10)
  sentAt              DateTime?   @map("sent_at")
  approvedAt          DateTime?   @map("approved_at")
  rejectedAt          DateTime?   @map("rejected_at")
  convertedAt         DateTime?   @map("converted_at")
  isSigned            Boolean     @default(false) @map("is_signed")
  signedAt            DateTime?   @map("signed_at")
  signedById          String?     @map("signed_by") @db.Uuid
  signatureUrl        String?     @map("signature_url") @db.VarChar(500)
  stampUrl            String?     @map("stamp_url") @db.VarChar(500)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  company          CompanySettings @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy        User            @relation("DevisCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  signedBy         User?           @relation("DevisSignedBy", fields: [signedById], references: [id], onDelete: SetNull)
  vatOverriddenBy  User?           @relation("DevisVatOverriddenBy", fields: [vatOverriddenById], references: [id], onDelete: SetNull)
  items            DevisItem[]
  generatedInvoice Invoice?        @relation("DevisToInvoice")

  @@index([devisNumber])
  @@index([status])
  @@index([issueDate])
  @@index([validUntil])
  @@index([customerId])
  @@index([createdById])
  @@index([signedById])
  @@index([vatOverriddenById])
  @@map("devis")
}

model DevisItem {
  id          String  @id @default(uuid()) @db.Uuid
  devisId     String  @map("devis_id") @db.Uuid
  description String  @db.Text
  unit        String? @db.VarChar(50)
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  devis Devis @relation(fields: [devisId], references: [id], onDelete: Cascade)

  @@index([devisId])
